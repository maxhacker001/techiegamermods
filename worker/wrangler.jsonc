{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "techie-gamer-mods-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "techie-gamer-mods",
      "database_id": "895f4818-f80b-42cb-8509-1a8513ce7afd"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "techie-gamer-mods-files"
    }
  ],

  "vars": {
    "WEB_ORIGIN": "https://maxhacker001.github.io"
  },

  "secrets": {
    "required": ["ADMIN_TOKEN"]
  }

  // Set ADMIN_TOKEN as a Wrangler secret. Never commit the real token.
}
